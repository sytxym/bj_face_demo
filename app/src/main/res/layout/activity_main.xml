<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="400dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="人脸核验"
            android:textColor="@color/home_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="请选择活体方式"
            android:textColor="@color/home_subtitle"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btTestFace"
            style="@style/HomeEntryButton"
            android:layout_marginTop="0dp"
            android:text="动作活体" />

        <Button
            android:id="@+id/btSilentFace"
            style="@style/HomeEntryButton"
            android:text="静默活体" />

        <Button
            android:id="@+id/btLocalFace"
            style="@style/HomeEntryButton"
            android:text="本地动作活体" />

        <Button
            android:id="@+id/btLocalLight"
            style="@style/HomeEntryButton"
            android:text="炫彩活体" />

        <Button
            android:id="@+id/btLocalMotionLight"
            style="@style/HomeEntryButton"
            android:text="动作+炫彩" />

        <Button
            android:id="@+id/btScanAuth"
            style="@style/HomeEntryButton.Outline"
            android:text="@string/scan_auth" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
