<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->


    <style name="ResultTextView" parent="@android:style/Widget">
        <item name="android:textColor">#FF008ED6</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="ResultFailTextView" parent="@android:style/Widget">
        <item name="android:textColor">#FF153D</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="HomeEntryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/btn_home_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="HomeEntryButton.Outline">
        <item name="android:background">@drawable/btn_home_outline</item>
        <item name="android:textColor">@color/home_btn_primary</item>
        <item name="android:elevation">0dp</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>







</resources>
