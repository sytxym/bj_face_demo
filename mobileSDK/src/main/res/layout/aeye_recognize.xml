<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.aeye.face.view.FaceView
        android:id="@+id/faceRect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/faceStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Space
                android:id="@+id/face_toolbar_gap"
                android:layout_width="match_parent"
                android:layout_height="76dp" />

            <Space
                android:id="@+id/face_block_top_gap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/face_block_top_offset" />

            <!-- 与上层 tvHint 占位对齐，避免闪光时文案层与取景错位 -->
            <Space
                android:id="@+id/face_hint_gap"
                android:layout_width="match_parent"
                android:layout_height="58dp" />

            <!-- 取景区：固定正方形尺寸，改 dimens 中 face_preview_panel_size 即可整体缩放 -->
            <FrameLayout
                android:id="@+id/face_preview_panel"
                android:layout_width="@dimen/face_preview_panel_size"
                android:layout_height="@dimen/face_preview_panel_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp">

                <SurfaceView
                    android:id="@+id/preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/iv_preview_freeze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- 提交核验：冻帧上圆形半透明遮罩 + 居中 loading -->
                <FrameLayout
                    android:id="@+id/face_submit_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/face_submit_overlay"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/pb_submit_loading"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@android:color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvMaskHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/face_result_success"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/aeye_anim_count"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEnvHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/aeye_selector_hit"
                    android:drawableStart="@drawable/aeye_anim_tip"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:visibility="invisible" />
            </FrameLayout>

            <!-- 与上层 tip 行占位对齐（提示文案 + 倒计时） -->
            <Space
                android:id="@+id/face_tip_gap"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.aeye.face.view.CountView
                android:id="@+id/tvRecogTimeCountdown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 炫彩闪光层：盖住取景白底；镂空与预览圆对齐 -->
    <com.aeye.face.lightView.CheckFaceView
        android:id="@+id/facebgview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 文案/语音按钮叠在闪光层之上，闪光时仍可见 -->
    <LinearLayout
        android:id="@+id/face_chrome_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:orientation="vertical">

        <Space
            android:id="@+id/face_chrome_toolbar_gap"
            android:layout_width="match_parent"
            android:layout_height="76dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:id="@+id/face_chrome_block_top_gap"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/face_block_top_offset" />

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="0dp"
                    android:text="@string/face_verify_subtitle"
                    android:textColor="@color/face_theme_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

        <!-- 扫描环叠在闪光层之上，与下方取景面板同尺寸对齐 -->
        <FrameLayout
            android:id="@+id/face_scan_ring_slot"
            android:layout_width="@dimen/face_preview_panel_size"
            android:layout_height="@dimen/face_preview_panel_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:clickable="false"
            android:focusable="false">

            <com.aeye.face.view.ScanRingOverlayView
                android:id="@+id/scan_ring_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false" />
        </FrameLayout>

        <Space
            android:id="@+id/face_result_top_gap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/face_result_block_offset"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/face_tip_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:minHeight="@dimen/face_tip_column_min_height">

            <!-- 结果态：ic_person_defalut + 通过/失败角标 -->
            <FrameLayout
                android:id="@+id/face_result_icon_wrap"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_result_person"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_person_defalut" />

                <ImageView
                    android:id="@+id/iv_result_badge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCheckHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:textColor="@color/face_theme_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFailDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/face_hint_sub"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvActionCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="10s"
                android:textColor="@color/face_hint_sub"
                android:textSize="16sp"
                android:visibility="invisible" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/face_fail_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_fail_retry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/aeye_btn_primary_navy"
                android:text="@string/face_retry_verify"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_fail_other"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/aeye_btn_outline_navy"
                android:text="@string/face_fail_back"
                android:textAllCaps="false"
                android:textColor="@color/face_theme_primary"
                android:textSize="15sp" />
        </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivVoice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:contentDescription="@string/aeye_msg_cancel"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/aeye_selector_voice" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/face_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/tvTop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/face_theme_primary"
            android:gravity="center"
            android:text="@string/face_title"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/ivReturn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/aeye_return"
            android:contentDescription="@string/aeye_msg_cancel"
            android:padding="12dp" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/introduceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/aeye_introduce" />

        <TextView
            android:id="@+id/introduceBegin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="30dp"
            android:background="@drawable/aeye_itd_btn_bg"
            android:gravity="center"
            android:text="@string/aeye_begin_recog"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </FrameLayout>
</RelativeLayout>
